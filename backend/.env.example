# =============================================================================
# NeuroFusionAI Backend Environment Template
# =============================================================================

APP_NAME="NeuroFusionAI - Parkinson Diagnostic Engine"
APP_ENV=production
DEBUG=false
HOST=127.0.0.1
PORT=8000
API_VERSION=v1
LOG_LEVEL=INFO

DATABASE_URL="postgresql+psycopg2://neondb_owner:YOUR_PASSWORD@ep-blue-field-b8bw9hgw-pooler.c-14.us-east-1.aws.neon.tech/neondb?sslmode=require"
SQLITE_DATABASE_PATH="uploads/parkinson_neon_store.db"

JWT_SECRET_KEY="replace-this-with-a-secure-random-64-character-hex-string"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

UPLOAD_DIR="uploads"
STORAGE_ROOT="uploads/medical_storage"
REPORT_DIR="storage/reports"
MAX_UPLOAD_SIZE_MB=25

FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8000"

