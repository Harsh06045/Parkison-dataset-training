# =============================================================================
# NeuroFusionAI - Enterprise Environment Configuration Template
# Copy this file to .env (or .env.local) and adjust values for your environment.
# =============================================================================

# Application Configuration
APP_NAME="NeuroFusionAI - Parkinson Diagnostic Engine"
APP_ENV=production
DEBUG=false
HOST=127.0.0.1
PORT=8000
API_VERSION=v1
LOG_LEVEL=INFO

# Database Configuration (Neon Cloud PostgreSQL Primary)
# Example: postgresql+psycopg2://user:password@ep-blue-field-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql+psycopg2://neondb_owner:YOUR_PASSWORD@ep-blue-field-b8bw9hgw-pooler.c-14.us-east-1.aws.neon.tech/neondb?sslmode=require"
NEON_DATABASE_URL=""
SQLITE_DATABASE_PATH="backend/uploads/parkinson_neon_store.db"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Security & Authentication (JWT & Passwords)
JWT_SECRET_KEY="replace-this-with-a-secure-random-64-character-hex-string"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_HASH_ALGORITHM=bcrypt

# Storage Configuration
UPLOAD_DIR="backend/uploads"
STORAGE_ROOT="backend/uploads/medical_storage"
REPORT_DIR="backend/storage/reports"
MAX_UPLOAD_SIZE_MB=25

# Machine Learning Checkpoints & Artifacts
MODEL_DEVICE=auto
MODEL_BATCH_SIZE=1
MODEL_TIMEOUT_SECONDS=30
SPIRAL_MODEL_PATH="outputs/checkpoints/image_best.pth"
VOICE_PYTORCH_PATH="outputs/checkpoints/voice_mlp_best.pth"
VOICE_CATBOOST_PATH="outputs/checkpoints/voice_best_model.pkl"
VOICE_SCALER_PATH="outputs/checkpoints/voice_scaler.pkl"
TELEMONITOR_PYTORCH_PATH="outputs/checkpoints/telemonitor_mlp_best.pth"
TELEMONITOR_XGB_PATH="outputs/checkpoints/telemonitor_best_model.pkl"
TELEMONITOR_SCALER_PATH="outputs/checkpoints/telemonitor_scaler.pkl"
MRI_MODEL_PATH="outputs/checkpoints/mri_best.pth"
FUSION_MODEL_PATH="outputs/checkpoints/fusion_best.pth"

# CORS & Application URLs
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8000"

